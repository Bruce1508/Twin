generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum ErrorCategory {
  grammaire
  lexique
  orthographe
  syntaxe
  registre
  comprehension
}

enum ClassroomRole {
  TEACHER
  STUDENT
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ReviewStatus {
  PROCESSING
  AI_DRAFT
  ANALYSIS_FAILED
  RETURNED_FOR_REVISION
  APPROVED
}

// error_tag is a plain String validated against the TS taxonomy at the app layer
// (keeping it out of the schema avoids duplicating the taxonomy in two places)

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  targetLevel   String   @default("B2")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions          Submission[]
  profile              Profile?
  drills               Drill[]
  readingExercises     ReadingExercise[]
  speakingExercises    SpeakingExercise[]
  flashcards           Flashcard[]
  listeningExercises   ListeningExercise[]
  sessionProgress      SessionProgress?
  tagSchedules         TagSchedule[]
  classroomMemberships ClassroomMember[]
  createdAssignments   Assignment[]       @relation("AssignmentCreator")
  completedReviews     SubmissionReview[] @relation("SubmissionReviewer")
  sessions             Session[]
  accounts             Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// A lightweight teaching boundary for the classroom MVP.
// Teacher/student permissions live on membership, not on User globally.
model Classroom {
  id        String   @id @default(cuid())
  name      String
  joinCode  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships ClassroomMember[]
  assignments Assignment[]
}

model ClassroomMember {
  id          String        @id @default(cuid())
  classroomId String
  userId      String
  role        ClassroomRole
  joinedAt    DateTime      @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([userId])
}

model Assignment {
  id           String           @id @default(cuid())
  classroomId  String
  createdById  String
  title        String
  instructions String
  taskType     String
  dueAt        DateTime?
  status       AssignmentStatus @default(DRAFT)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  classroom  Classroom   @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("AssignmentCreator", fields: [createdById], references: [id])
  submissions Submission[]

  @@index([classroomId, status])
}

// A single unit of language production — immutable after creation.
// source: "free_practice" | "drill_response"
model Submission {
  id            String   @id @default(cuid())
  userId        String
  assignmentId  String?
  attemptNumber Int      @default(1)
  source        String
  prompt        String?
  content       String
  wordCount     Int
  metrics       Json
  createdAt     DateTime @default(now())

  user                    User               @relation(fields: [userId], references: [id])
  assignment              Assignment?        @relation(fields: [assignmentId], references: [id])
  review                  SubmissionReview?
  errorEvents             ErrorEvent[]
  // When this submission is the response to a drill, the drill links back here.
  drillAnswer             Drill?             @relation("DrillResponse")
  // When this submission is the response to a reading exercise, it links back here.
  readingExerciseAnswer   ReadingExercise?   @relation("ReadingExerciseResponse")
  // When this submission is the response to a speaking exercise, it links back here.
  speakingExerciseAnswer  SpeakingExercise?  @relation("SpeakingExerciseResponse")
  listeningExerciseAnswer ListeningExercise? @relation("ListeningExerciseResponse")

  @@unique([assignmentId, userId, attemptNumber])
  @@index([assignmentId, userId])
}

model SubmissionReview {
  id                 String       @id @default(cuid())
  submissionId       String       @unique
  status             ReviewStatus @default(PROCESSING)
  aiExtraction       Json?
  aiRubric           Json?
  reviewedExtraction Json?
  teacherFeedback    String?
  modelName          String?
  promptVersion      String?
  reviewedById       String?
  reviewedAt         DateTime?
  confirmedAt        DateTime?
  failureReason      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("SubmissionReviewer", fields: [reviewedById], references: [id])
}

// A single error extracted from a Submission — immutable after creation.
// excerpt is null for whole-text observations (no specific span).
// errorTag is validated against TAXONOMY_TAGS at the app layer before write.
model ErrorEvent {
  id           String        @id @default(cuid())
  submissionId String
  category     ErrorCategory
  errorTag     String
  excerpt      String?
  correction   String
  explanation  String
  createdAt    DateTime      @default(now())

  submission Submission @relation(fields: [submissionId], references: [id])
  drills     Drill[]
  flashcard  Flashcard?
}

// Derived ability profile — NOT a source of truth.
// Must only be written by the recompute function, never directly.
// computedAt is auto-set on every write, making any stale manual write visible.
model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  errorFrequencies Json
  knownVocab       Int      @default(0)
  complexityTrend  Json
  computedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// Single-row-per-user queue state for the "Aujourd'hui" daily session.
// planPosition is a QUEUE index into lib/plan.ts PLAN — it advances only when a
// session is completed, never by calendar date, so skipped days never create a
// "behind" state. activeSession holds the in-progress SessionStep[] for resume.
model SessionProgress {
  id              String    @id @default(cuid())
  userId          String    @unique
  planPosition    Int       @default(1)
  activeSession   Json?
  startedAt       DateTime?
  lastCompletedAt DateTime?

  user User @relation(fields: [userId], references: [id])
}

// A practice item produced by the generation layer.
// sourceErrorId: the specific ErrorEvent that triggered this drill (always set for Reverse Tutor).
// responseSubmissionId: set when the learner answers — closes the loop.
// resolved: true once the tag is considered mastered (set by targeting logic in M5).
model Drill {
  id                   String   @id @default(cuid())
  userId               String
  type                 String
  payload              Json
  resolved             Boolean  @default(false)
  sourceErrorId        String?
  responseSubmissionId String?  @unique
  createdAt            DateTime @default(now())

  user               User        @relation(fields: [userId], references: [id])
  sourceError        ErrorEvent? @relation(fields: [sourceErrorId], references: [id])
  responseSubmission Submission? @relation("DrillResponse", fields: [responseSubmissionId], references: [id])
}

// SRS schedule for one ErrorEvent. Created lazily on first /flashcards visit.
// interval is in days; easeFactor is SM-2 ease multiplier (floor 1.3).
// dueAt drives the review queue — cards surface when dueAt <= now().
model Flashcard {
  id             String    @id @default(cuid())
  userId         String
  errorEventId   String    @unique
  dueAt          DateTime  @default(now())
  interval       Int       @default(1)
  easeFactor     Float     @default(2.5)
  reviewCount    Int       @default(0)
  lastReviewedAt DateTime?

  user       User       @relation(fields: [userId], references: [id])
  errorEvent ErrorEvent @relation(fields: [errorEventId], references: [id])
}

// Spaced-repetition schedule for one (userId, errorTag) pair. Created lazily
// by updateMasterySignal on first grade for that tag. Absence of a row means
// the tag has never been scheduled and is always eligible for selection.
// consecutiveImproving doubles as the index into targeting.ts's LADDER_DAYS.
model TagSchedule {
  id                   String   @id @default(cuid())
  userId               String
  errorTag             String
  dueAt                DateTime @default(now())
  consecutiveImproving Int      @default(0)
  lastDrilledAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, errorTag])
}

// Stores a speaking exercise: generated prompt + transcript + grading results.
// transcriptText is set by the /transcribe step, grading by the /grade step.
// submissionId is set when grading completes, closing the loop.
model SpeakingExercise {
  id              String   @id @default(cuid())
  userId          String
  topic           String
  promptText      String
  scenarioContext String
  transcriptText  String?
  grading         Json?
  submissionId    String?  @unique
  createdAt       DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id])
  submission Submission? @relation("SpeakingExerciseResponse", fields: [submissionId], references: [id])
}

// Stores a listening exercise: generated passage + MCQ questions with answer keys.
// passageType: "dialogue" | "monologue". Audio is derived from passageText on demand.
// submissionId is set when the learner submits answers, closing the loop.
model ListeningExercise {
  id           String   @id @default(cuid())
  userId       String
  passageText  String
  topic        String?
  passageType  String
  questions    Json
  submissionId String?  @unique
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id])
  submission Submission? @relation("ListeningExerciseResponse", fields: [submissionId], references: [id])
}

// Stores tutor session notes and homework assignments (singleton pattern — no userId).
// Always use the most recent row. New row = new session.
model TutorNote {
  id        String   @id @default(cuid())
  notes     String   @default("")
  homework  String   @default("")
  createdAt DateTime @default(now())
}

// Stores a reading exercise: article + generated questions with answer keys.
// submissionId is set when the learner submits answers, closing the loop.
// articleSource: "pasted" | "generated"
model ReadingExercise {
  id            String   @id @default(cuid())
  userId        String
  articleText   String
  topic         String?
  articleSource String
  questions     Json
  submissionId  String?  @unique
  createdAt     DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id])
  submission Submission? @relation("ReadingExerciseResponse", fields: [submissionId], references: [id])
}
